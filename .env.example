# ── .env ───────────────────────────────────────────────────
# Database
ICEBADGER_DB_PATH=icebadger.db

# OAuth 2.0 Credentials (Microsoft Entra ID v2.0)
ICEBADGER_CLIENT_ID=29d9ed98-a469-4536-ade2-f981bc1d605e
ICEBADGER_TENANT_ID=common
ICEBADGER_DEVICE_CODE_URL=https://login.microsoftonline.com/common/oauth2/v2.0/devicecode
ICEBADGER_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token

# Scopes required for brokered authentication and persistent access
# offline_access is mandatory for refresh token issuance
ICEBADGER_SCOPES=https://graph.microsoft.com/.default openid profile offline_access

# Polling Settings
ICEBADGER_POLL_INTERVAL=5
ICEBADGER_MAX_RETRIES=3
ICEBADGER_RETRY_DELAY=5.0
ICEBADGER_LOG_LEVEL=INFO

# Capture concurrency. CHAIN_CONCURRENCY is measured: throughput plateaus at
# ~10 on a 1-core box and extra workers only add latency. CHAIN_PER_TENANT
# stops one tenant taking the whole pool; CHAIN_ADMIN_RATIO is admin picks per
# tenant pick (3 => admin gets 3 of every 4 slots, tenants never starved).
ICEBADGER_CHAIN_CONCURRENCY=10
ICEBADGER_CHAIN_PER_TENANT=3
ICEBADGER_CHAIN_ADMIN_RATIO=3

# Web Dashboard
ICEBADGER_WEB_HOST=0.0.0.0
ICEBADGER_WEB_PORT=5000
